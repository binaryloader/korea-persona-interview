# Copy this file to `.env` at the project root, then fill in the API key for
# the provider you plan to use. `.env` is loaded automatically (stdlib parser)
# and only secrets are promoted to env. Already-set environment variables take
# precedence (setdefault semantics).

# OpenAI API key (https://platform.openai.com/api-keys), used when llm.provider=openai.
# Local LLMs (mlx_lm.server, vLLM, llama.cpp) reuse this slot and accept any non-empty value.
OPENAI_API_KEY=sk-replace-with-your-key

# Anthropic API key (https://console.anthropic.com/), used when llm.provider=anthropic.
# ANTHROPIC_API_KEY=sk-ant-replace-with-your-key
