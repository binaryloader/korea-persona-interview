# Copy this file to `.env` at the project root, then fill in your real OpenAI API key.
# `.env` is loaded automatically (stdlib parser) and only secrets are promoted to env.
# Already-set environment variables take precedence (setdefault semantics).
#
# Get a key from https://platform.openai.com/api-keys

OPENAI_API_KEY=sk-replace-with-your-key

# Optional: project-only key used as a fallback when OPENAI_API_KEY is unset.
# Useful when you want to keep the project key separate from a shell-wide OPENAI_API_KEY.
# KPI_OPENAI_API_KEY=sk-replace-with-your-key
