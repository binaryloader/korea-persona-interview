# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 가상 환경
.venv/
venv/
env/
ENV/

# 빌드/배포 산출물
build/
dist/
*.egg-info/
*.egg

# uv lockfile: requirements.lock이 정본이므로 추적하지 않는다
uv.lock

# 환경 변수
# .env: 표준 OPENAI_API_KEY 등 시크릿 보관 파일
# .env.*: .env.local, .env.staging.local 같은 셸 관례 패턴 모두 차단
# !.env.example: 템플릿은 커밋 허용
.env
.env.*
!.env.example

# 에디터/OS
.DS_Store
.idea/
.vscode/
*.swp

# 인터뷰 결과/리포트/로그(outputs/.gitkeep만 유지)
outputs/*.json
outputs/*.md
outputs/logs/
!outputs/.gitkeep
